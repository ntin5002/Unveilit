# Unveilyx 0.5.17 — Railway deployment variable template
# Copy values into Railway service Variables. Never commit real secrets.
# Database reference-variable examples assume Railway services named:
#   PlatformPostgres
#   PhotoPostgres

# Public branding (build-time for Next.js NEXT_PUBLIC_* values)
NEXT_PUBLIC_APP_NAME=Unveilyx
NEXT_PUBLIC_APP_TAGLINE=Professional Photo Delivery
NEXT_PUBLIC_APP_DESCRIPTION=Protected photography proofing, payment, and delivery platform.

# Railway PostgreSQL reference variables
PLATFORM_DATABASE_URL=${{PlatformPostgres.DATABASE_URL}}
PHOTO_DATABASE_URL=${{PhotoPostgres.DATABASE_URL}}

# Production identity. Configure PLATFORM_API_ORIGIN when Shared Platform Core is available.
# Otherwise use SIGNATIVE_API_ORIGIN as the transitional identity source.
# Do not depend on PHOTO_LOCAL_AUTH in production; the code intentionally disables it.
PLATFORM_API_ORIGIN=
PLATFORM_CONTEXT_PATH=/api/auth/me
SIGNATIVE_API_ORIGIN=
SIGNATIVE_CONTEXT_PATH=/api/auth/me
PHOTO_LOCAL_AUTH=false

# Private Cloudflare R2 storage — required in production
PHOTO_STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upload / workers
PHOTO_UPLOAD_URL_TTL_SECONDS=900
PHOTO_UPLOAD_MAX_BYTES=104857600
PHOTO_UPLOAD_BROWSER_CONCURRENCY=4
PHOTO_WORKER_CONCURRENCY=2
PHOTO_WORKER_POLL_MS=1000
PHOTO_WORKER_LOCK_TIMEOUT_MINUTES=15
PHOTO_WORKER_MAX_ATTEMPTS=3
PHOTO_WORKER_VERSION=0.5.17
PHOTO_WORKER_MAX_PIXELS=150000000
DELIVERY_WORKER_CONCURRENCY=1
DELIVERY_WORKER_POLL_MS=1800
DELIVERY_WORKER_LOCK_TIMEOUT_MINUTES=20
DELIVERY_WORKER_VERSION=0.5.17
PHOTO_THUMBNAIL_MAX_DIMENSION=640
PHOTO_WATERMARK_TEXT=PROOF

# Strong, independent production secrets. Generate separate random values.
PHOTO_MEDIA_SESSION_SECRET=
PHOTO_MEDIA_SESSION_TTL_SECONDS=600
PHOTO_FORENSIC_SECRET=
PHOTO_INTEGRATION_SECRET_KEY=

# Set after Railway domain/custom domain exists, e.g. https://unveilyx.example.com
PHOTO_PUBLIC_ORIGIN=

# Provider fallback credentials. Organizations can override supported providers in-app.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
GOOGLE_DRIVE_API_KEY=
PHOTO_LINK_IMPORT_MAX_FILES=5000
PHOTO_LINK_IMPORT_MAX_FILE_BYTES=500000000
PHOTO_LINK_IMPORT_STALE_MINUTES=15

SIGNATIVE_INTEGRATION_WEBHOOK_SECRET=

# Optional Photo-owned customer payments
PHOTO_ENABLE_LOCAL_PAYMENT_TEST=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_API_VERSION=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Never enable the diagnostic protection panel on a public production deployment.
PHOTO_ENABLE_PROTECTION_TEST_PANEL=false
NEXT_PUBLIC_PHOTO_ENABLE_PROTECTION_TEST_PANEL=false
