# Public product branding (safe to expose to the browser)
NEXT_PUBLIC_APP_NAME=Photo Delivery
NEXT_PUBLIC_APP_TAGLINE=Professional Delivery
NEXT_PUBLIC_APP_DESCRIPTION=Protected photography proofing, payment, and delivery platform.

# Local database mode:
#   pglite  = default, embedded PostgreSQL/WASM; Docker is NOT required.
#   docker  = use the two PostgreSQL services in docker-compose.yml.
#   postgres= use PostgreSQL already running at the URLs below.
PHOTO_LOCAL_DATABASE_MODE=pglite

# Embedded PGlite directories (local testing only).
PLATFORM_PGLITE_DIR=.local-db/platform-core
PHOTO_PGLITE_DIR=.local-db/photo-delivery

# Native PostgreSQL URLs used by docker/postgres mode and production.
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/platform_core
PHOTO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/photo_delivery

PLATFORM_API_ORIGIN=
PLATFORM_CONTEXT_PATH=/api/auth/me
SIGNATIVE_API_ORIGIN=
SIGNATIVE_CONTEXT_PATH=/api/auth/me

PHOTO_LOCAL_AUTH=true
PHOTO_LOCAL_ACCOUNT_ID=00000000-0000-4000-8000-000000000001
PHOTO_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000101

# Local development uses private filesystem storage so R2 credentials are not required.
# Set this to r2 and fill the R2 variables below to test real R2 locally.
PHOTO_STORAGE_DRIVER=local
PHOTO_LOCAL_STORAGE_PATH=.local-storage/photo-delivery
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

PHOTO_UPLOAD_URL_TTL_SECONDS=900
PHOTO_UPLOAD_MAX_BYTES=104857600
# Browser upload queue concurrency is clamped to 3-6.
PHOTO_UPLOAD_BROWSER_CONCURRENCY=4
PHOTO_WORKER_CONCURRENCY=2
PHOTO_WORKER_POLL_MS=1000
PHOTO_WORKER_LOCK_TIMEOUT_MINUTES=15
PHOTO_WORKER_MAX_ATTEMPTS=3
PHOTO_WORKER_VERSION=0.5.17
PHOTO_WORKER_MAX_PIXELS=150000000
DELIVERY_WORKER_CONCURRENCY=1
DELIVERY_WORKER_POLL_MS=1800
DELIVERY_WORKER_LOCK_TIMEOUT_MINUTES=20
DELIVERY_WORKER_VERSION=0.5.17
# Proof long edge is selected per gallery and restricted in code to 1500 or 2048 px.
PHOTO_THUMBNAIL_MAX_DIMENSION=640
PHOTO_WATERMARK_TEXT=PROOF

# Public proof delivery uses a signed HttpOnly media-session cookie and same-origin application proxy.
# Required in production; local development has a non-production fallback only.
PHOTO_MEDIA_SESSION_SECRET=
PHOTO_MEDIA_SESSION_TTL_SECONDS=600

# HMAC key for the worker-baked per-client forensic TRACE code. Required in production.
PHOTO_FORENSIC_SECRET=

# Public origin used to build OAuth callback URLs.
PHOTO_PUBLIC_ORIGIN=http://localhost:3000
# Encrypts OAuth refresh/access tokens and organization provider credentials stored in the Photo database. Required in production.
# Keep this value stable across deploys; rotating it without a re-encryption migration makes existing encrypted integration data unreadable.
PHOTO_INTEGRATION_SECRET_KEY=
# Provider variables below are platform fallback credentials. Authorized organizations can override them securely in Dashboard -> Integrations.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Optional for public Google Drive shared links when OAuth is not connected.
# Optional for Link Import. Public Anyone-with-the-link Drive links are attempted without credentials first.
# Configure this for official public-folder API discovery/fallback.
GOOGLE_DRIVE_API_KEY=
# Link Import discovery/transfer guards.
PHOTO_LINK_IMPORT_MAX_FILES=5000
PHOTO_LINK_IMPORT_MAX_FILE_BYTES=500000000
PHOTO_LINK_IMPORT_STALE_MINUTES=15

SIGNATIVE_INTEGRATION_WEBHOOK_SECRET=

# Photo-owned customer payment providers. Platform Core still owns SaaS subscriptions/product entitlements.
# Local test checkout is available automatically outside production; set true only for controlled production diagnostics.
PHOTO_ENABLE_LOCAL_PAYMENT_TEST=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_API_VERSION=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Local/diagnostic Theft Prevention Test Panel. Disabled by default in production.
PHOTO_ENABLE_PROTECTION_TEST_PANEL=false
NEXT_PUBLIC_PHOTO_ENABLE_PROTECTION_TEST_PANEL=false
